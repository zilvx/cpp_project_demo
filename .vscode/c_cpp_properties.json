{
    "configurations": [
        {
            "name": "clang",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/**",
                "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include/c++/v1",
                "${workspaceFolder}/build/**",
                "/opt/homebrew/opt/qt/include",
                "/opt/homebrew/opt/qt/lib/QtCore.framework/Headers",
                "/opt/homebrew/opt/qt/lib/QtGui.framework/Headers",
                "/opt/homebrew/opt/qt/lib/QtWidgets.framework/Headers",
                "/opt/homebrew/opt/qt/lib/QtNetwork.framework/Headers",
                "/opt/homebrew/opt/protobuf/include",
                "/opt/homebrew/opt/abseil/include"
            ],
            "defines": [],
            "compilerPath": "/usr/bin/clang++",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-clang-arm64"
        }
    ],
    "version": 4
}