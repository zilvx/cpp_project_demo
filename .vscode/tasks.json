{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build the project using CMake"
        },
        {
            "label": "Conan Install",
            "type": "shell",
            "command": "conan",
            "args": [
                "install",
                ".",
                "--output-folder=.",
                "--build=missing",
                "-s",
                "build_type=Release"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "Install Conan dependencies"
        },
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "Configure CMake project"
        },
        {
            "label": "Full Rebuild (Conan + CMake)",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Conan Install",
                "CMake Configure",
                "CMake Build"
            ],
            "problemMatcher": [],
            "group": "build",
            "detail": "Full rebuild from scratch"
        }
    ]
}
