/* ============================================
   98 键机械键盘 — 深色键帽样式
   ============================================ */

/* 键盘底板 */
VirtualKeyboard {
    background-color: #1a1d2e;
    border-radius: 8px;
}

/* === 通用键帽 === */
QPushButton {
    background-color: #2c3042;
    color: rgba(255, 255, 255, 0.85);
    border: 1px solid #3a3f55;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    padding: 2px;
}

/* 键帽底部阴影 → 立体感 */
QPushButton {
    border-bottom: 3px solid #1f2233;
}

QPushButton:hover {
    background-color: #383d52;
    border-color: #4a5068;
}

QPushButton:pressed {
    background-color: #1f2233;
    border-bottom: 1px solid #1a1d2e;
    padding-top: 4px;
    padding-bottom: 0px;
}

/* === 功能键（长键 / 修饰键）=== */
QPushButton[keyClass="special"] {
    background-color: #252839;
    color: rgba(255, 255, 255, 0.75);
    font-size: 12px;
}

QPushButton[keyClass="special"]:hover {
    background-color: #2f3346;
}

QPushButton[keyClass="special"]:pressed {
    background-color: #1a1d2e;
}

/* === 空格键 === */
QPushButton[keyClass="space"] {
    background-color: #2c3042;
    border-radius: 8px;
}
