/* ====== 基础工具子界面 - 左侧导航对齐 ArbWidget / 主 Tab 风格 ====== */

#BasicToolsWidget {
    background: #ffffff;
}

#btNavPanel {
    background: #ffffff;
    border-right: 1px solid #e0e5ec;
}

#btNavHeader {
    font-size: 10px;
    font-weight: 700;
    color: #6a7a8a;
    text-transform: uppercase;
    padding: 6px 18px 4px 18px;
    letter-spacing: 0.5px;
}

#btNavItem {
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 0;
    padding: 8px 18px;
    font-size: 13px;
    color: #3a4a5a;
    text-align: left;
    min-width: 0;
}

#btNavItem:hover {
    background: rgba(42, 111, 156, 0.04);
    color: #3a4a5a;
}

#btNavItem:checked {
    background: rgba(42, 111, 156, 0.08);
    border-left: 3px solid #2a6f9c;
    color: #0d1b2a;
    font-weight: 500;
}

#btNavBadge {
    background: #cdd3db;
    color: #4a5a6a;
    font-size: 9px;
    padding: 1px 8px;
    border-radius: 10px;
    font-weight: 600;
    min-width: 18px;
    text-align: center;
    margin-right: 10px;
}

#btNavBadge[active="true"] {
    background: #2a6f9c;
    color: #ffffff;
}

#btNavDivider {
    background: #e0e5ec;
    max-height: 1px;
    margin: 10px 18px;
}

#btNavHint {
    font-size: 11px;
    color: #8a9aaa;
    padding: 4px 18px;
}

#btStack {
    background: #ffffff;
}

#btSplitter::handle {
    background: #e0e5ec;
    width: 1px;
}

#btSplitter::handle:hover {
    background: #2a6f9c;
}
