/**
 * ========================================
 * 设计系统基础样式 - 设计令牌
 * ========================================
 * 统一的颜色、间距、圆角、字体等视觉规范
 */

/* ====== 全局样式 ====== */
QWidget {
    font-family: 'PingFang SC', 'Helvetica Neue', 'Arial', sans-serif;
    font-size: 13px;
    color: #1a2a3a;
    background-color: #f8f9fb;
}

/* ====== 颜色系统 ====== */
:root {
    /* 主色调 */
    --primary: #2a6f9c;
    --primary-dark: #1e5a80;
    --primary-light: #4a9fc9;

    /* 次要色 */
    --secondary: #f39c12;
    --secondary-dark: #d68910;
    --secondary-light: #f7b731;

    /* 成功/警告/错误色 */
    --success: #27ae60;
    --warning: #f39c12;
    --danger: #e74c3c;
    --error: #c0392b;

    /* 背景色 */
    --bg-primary: #ffffff;
    --bg-secondary: #f8f9fb;
    --bg-tertiary: #e8ecf1;
    --bg-hover: #e0e5ec;

    /* 文本色 */
    --text-primary: #1a2a3a;
    --text-secondary: #6b7b8c;
    --text-tertiary: #a0b0c0;
    --text-inverse: #ffffff;

    /* 边框色 */
    --border-primary: #cdd3db;
    --border-secondary: #d9dce1;
    --border-focus: #2a6f9c;
}

/* ====== 按钮样式 ====== */
QPushButton {
    background-color: var(--primary);
    color: var(--text-inverse);
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
    min-width: 80px;
    transition: all 0.2s ease;
}

QPushButton:hover:not(:disabled) {
    background-color: var(--primary-dark);
}

QPushButton:pressed:not(:disabled) {
    background-color: var(--primary-light);
}

QPushButton:disabled {
    background-color: var(--bg-tertiary);
    color: var(--text-tertiary);
}

/* 次要按钮 */
QPushButton.secondary {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    border: 1px solid var(--border-primary);
}

QPushButton.secondary:hover:not(:disabled) {
    background-color: var(--bg-hover);
    border-color: var(--border-secondary);
}

/* 危险按钮 */
QPushButton.danger {
    background-color: var(--danger);
}

QPushButton.danger:hover:not(:disabled) {
    background-color: var(--error);
}

/* ====== 输入框样式 ====== */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    border: 1px solid var(--border-primary);
    border-radius: 4px;
    padding: 6px;
    font-size: 13px;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border-color: var(--border-focus);
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
    background-color: var(--bg-tertiary);
    color: var(--text-tertiary);
}

/* ====== 标签页样式 ====== */
QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabBar::tab {
    background-color: var(--bg-tertiary);
    color: var(--text-secondary);
    padding: 10px 20px;
    margin-right: 2px;
    border: 1px solid var(--border-secondary);
    border-bottom: none;
    font-size: 13px;
    font-weight: 500;
    min-width: 80px;
    border-radius: 4px 4px 0 0;
}

QTabBar::tab:selected {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    border-bottom-color: var(--bg-primary);
}

QTabBar::tab:hover {
    background-color: var(--bg-hover);
}

/* ====== 滚动条样式 ====== */
QScrollBar:vertical {
    background-color: var(--bg-tertiary);
    width: 12px;
    margin: 0;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: var(--text-tertiary);
    min-height: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: var(--text-primary);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background-color: var(--bg-tertiary);
    height: 12px;
    margin: 0;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: var(--text-tertiary);
    min-width: 20px;
    border-radius: 6px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background-color: var(--text-primary);
}

/* ====== 分组框样式 ====== */
QGroupBox {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: 8px;
    margin-top: 4px;
    padding: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    margin-left: 10px;
    font-weight: 600;
    color: var(--primary);
}

/* ====== 复选框/单选框样式 ====== */
QCheckBox, QRadioButton {
    color: var(--text-primary);
    spacing: 8px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid var(--border-primary);
    border-radius: 4px;
    background-color: var(--bg-primary);
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border-color: var(--border-focus);
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: var(--primary);
    border-color: var(--primary);
}

QCheckBox::indicator:checked:indeterminate,
QRadioButton::indicator:checked:indeterminate {
    background-color: var(--warning);
    border-color: var(--warning);
}

/* ====== 进度条样式 ====== */
QProgressBar {
    background-color: var(--bg-tertiary);
    border: none;
    border-radius: 2px;
    height: 6px;
}

QProgressBar::chunk {
    background-color: var(--success);
    border-radius: 2px;
    transition: width 0.2s ease;
}

/* ====== 菜单/下拉框样式 ====== */
QMenu {
    background-color: var(--bg-primary);
    border: 1px solid var(--border-primary);
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 16px;
    border-radius: 2px;
}

QMenu::item:selected {
    background-color: var(--bg-hover);
}

QComboBox QAbstractItemView {
    background-color: var(--bg-primary);
    selection-background-color: var(--primary);
    selection-color: var(--text-inverse);
    outline: none;
}

/* ====== 状态栏样式 ====== */
QStatusBar {
    background-color: var(--bg-primary);
    border-top: 1px solid var(--border-primary);
    color: var(--text-secondary);
}

QStatusBar::item {
    border: none;
}

/* ====== 网格布局边距 ====== */
QGridLayout {
    margin: 0;
    spacing: 12px;
}

/* ====== 空白区 ====== */
QSpacerItem {
    background-color: transparent;
}
